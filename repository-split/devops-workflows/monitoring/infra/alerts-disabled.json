{
    "$schema":  "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion":  "1.0.0.0",
    "parameters":  {
                       "namePrefix":  {
                                          "defaultValue":  "prd-cicdobservability-doc-extraction",
                                          "type":  "string"
                                      },
                       "repository":  {
                                          "defaultValue":  "northwest/doc_extraction",
                                          "type":  "string"
                                      },
                       "location":  {
                                        "defaultValue":  "eastus2",
                                        "type":  "string"
                                    },
                       "workspaceResourceId":  {
                                                   "type":  "string"
                                               },
                       "actionGroupIds":  {
                                              "defaultValue":  [

                                                               ],
                                              "type":  "array"
                                          },
                       "selectedWorkflowPaths":  {
                                                     "defaultValue":  [

                                                                      ],
                                                     "type":  "array"
                                                 }
                   },
    "resources":  [
                      {
                          "type":  "Microsoft.Insights/scheduledQueryRules",
                          "apiVersion":  "2023-12-01",
                          "name":  "[concat(parameters(\u0027namePrefix\u0027), \u0027-collector-heartbeat-missing\u0027)]",
                          "location":  "[parameters(\u0027location\u0027)]",
                          "kind":  "LogAlert",
                          "properties":  {
                                             "displayName":  "NWB collector-heartbeat-missing",
                                             "description":  "CI/CD monitoring draft. Review ownership, thresholds and routing before enabling.",
                                             "enabled":  false,
                                             "severity":  2,
                                             "autoMitigate":  true,
                                             "evaluationFrequency":  "PT5M",
                                             "windowSize":  "PT1H",
                                             "overrideQueryTimeRange":  "PT2H",
                                             "scopes":  [
                                                            "[parameters(\u0027workspaceResourceId\u0027)]"
                                                        ],
                                             "skipQueryValidation":  false,
                                             "actions":  {
                                                             "actionGroups":  "[parameters(\u0027actionGroupIds\u0027)]"
                                                         },
                                             "criteria":  {
                                                              "allOf":  [
                                                                            {
                                                                                "query":  "[replace(\u0027// Expected row ensures this returns an alert row even when the table is empty.\n// Enable only after the scheduled watchdog has published successfully.\nlet expected = datatable(Repository:string, Collector:string)\n    [\u0027\u0027__NWB_REPOSITORY__\u0027\u0027, \u0027\u0027nwb-cicd\u0027\u0027];\nexpected\n| join kind=leftouter (\n    NWBCollectorHealth_CL\n    | where TimeGenerated \u003e ago(2h) and Operation == \u0027\u0027heartbeat\u0027\u0027 and Outcome == \u0027\u0027success\u0027\u0027\n    | summarize LastHeartbeat=max(TimeGenerated) by Repository, Collector\n) on Repository, Collector\n| where isnull(LastHeartbeat) or LastHeartbeat \u003c ago(60m)\n| project Repository, Collector, LastHeartbeat\n\u0027, \u0027__NWB_REPOSITORY__\u0027, parameters(\u0027repository\u0027))]",
                                                                                "operator":  "GreaterThan",
                                                                                "threshold":  0,
                                                                                "timeAggregation":  "Count",
                                                                                "failingPeriods":  {
                                                                                                       "minFailingPeriodsToAlert":  2,
                                                                                                       "numberOfEvaluationPeriods":  2
                                                                                                   }
                                                                            }
                                                                        ]
                                                          }
                                         }
                      },
                      {
                          "type":  "Microsoft.Insights/scheduledQueryRules",
                          "apiVersion":  "2023-12-01",
                          "name":  "[concat(parameters(\u0027namePrefix\u0027), \u0027-collector-failed\u0027)]",
                          "location":  "[parameters(\u0027location\u0027)]",
                          "kind":  "LogAlert",
                          "properties":  {
                                             "displayName":  "NWB collector-failed",
                                             "description":  "CI/CD monitoring draft. Review ownership, thresholds and routing before enabling.",
                                             "enabled":  false,
                                             "severity":  2,
                                             "autoMitigate":  true,
                                             "evaluationFrequency":  "PT5M",
                                             "windowSize":  "PT1H",
                                             "overrideQueryTimeRange":  "PT2H",
                                             "scopes":  [
                                                            "[parameters(\u0027workspaceResourceId\u0027)]"
                                                        ],
                                             "skipQueryValidation":  false,
                                             "actions":  {
                                                             "actionGroups":  "[parameters(\u0027actionGroupIds\u0027)]"
                                                         },
                                             "criteria":  {
                                                              "allOf":  [
                                                                            {
                                                                                "query":  "[replace(\u0027// Re-observation of an old run must not make it a new failure.\n// The most recent rerun attempt takes precedence over earlier failures.\nNWBCollectorHealth_CL\n| where Repository == \u0027\u0027__NWB_REPOSITORY__\u0027\u0027\n| where TimeGenerated \u003e ago(2h) and Operation == \u0027\u0027collector-run\u0027\u0027\n| summarize arg_max(UpdatedAt, *) by Repository, Collector, SourceRunId, SourceRunAttempt\n| summarize arg_max(SourceRunAttempt, *) by Repository, Collector, SourceRunId\n| where SourceUpdatedAt \u003e ago(1h) and Outcome == \u0027\u0027failure\u0027\u0027\n| project Repository, Collector, SourceRunId, SourceRunAttempt, DetailCode, SourceUpdatedAt\n\u0027, \u0027__NWB_REPOSITORY__\u0027, parameters(\u0027repository\u0027))]",
                                                                                "operator":  "GreaterThan",
                                                                                "threshold":  0,
                                                                                "timeAggregation":  "Count",
                                                                                "failingPeriods":  {
                                                                                                       "minFailingPeriodsToAlert":  2,
                                                                                                       "numberOfEvaluationPeriods":  2
                                                                                                   }
                                                                            }
                                                                        ]
                                                          }
                                         }
                      },
                      {
                          "type":  "Microsoft.Insights/scheduledQueryRules",
                          "apiVersion":  "2023-12-01",
                          "name":  "[concat(parameters(\u0027namePrefix\u0027), \u0027-selected-workflow-failed\u0027)]",
                          "location":  "[parameters(\u0027location\u0027)]",
                          "kind":  "LogAlert",
                          "properties":  {
                                             "displayName":  "NWB selected-workflow-failed",
                                             "description":  "CI/CD monitoring draft. Review ownership, thresholds and routing before enabling.",
                                             "enabled":  false,
                                             "severity":  2,
                                             "autoMitigate":  true,
                                             "evaluationFrequency":  "PT5M",
                                             "windowSize":  "PT1H",
                                             "overrideQueryTimeRange":  "PT2H",
                                             "scopes":  [
                                                            "[parameters(\u0027workspaceResourceId\u0027)]"
                                                        ],
                                             "skipQueryValidation":  false,
                                             "actions":  {
                                                             "actionGroups":  "[parameters(\u0027actionGroupIds\u0027)]"
                                                         },
                                             "criteria":  {
                                                              "allOf":  [
                                                                            {
                                                                                "query":  "[replace(replace(\u0027// Empty allowlist is intentional. Populate only after owner/severity review.\nlet selectedPaths = dynamic([]);\nNWBWorkflowRuns_CL\n| where TimeGenerated \u003e ago(2h) and Repository == \u0027\u0027__NWB_REPOSITORY__\u0027\u0027\n| where WorkflowPath in (selectedPaths)\n| summarize arg_max(UpdatedAt, *) by Repository, RunId, RunAttempt\n| summarize arg_max(RunAttempt, *) by Repository, RunId\n| where CompletedAt \u003e ago(1h) and Conclusion in (\u0027\u0027failure\u0027\u0027, \u0027\u0027timed_out\u0027\u0027)\n| project Repository, PipelineName, WorkflowPath, RunId, RunAttempt, Conclusion, CompletedAt, RunUrl\n\u0027, \u0027__NWB_REPOSITORY__\u0027, parameters(\u0027repository\u0027)), \u0027dynamic([])\u0027, concat(\u0027dynamic(\u0027, string(parameters(\u0027selectedWorkflowPaths\u0027)), \u0027)\u0027))]",
                                                                                "operator":  "GreaterThan",
                                                                                "threshold":  0,
                                                                                "timeAggregation":  "Count",
                                                                                "failingPeriods":  {
                                                                                                       "minFailingPeriodsToAlert":  2,
                                                                                                       "numberOfEvaluationPeriods":  2
                                                                                                   }
                                                                            }
                                                                        ]
                                                          }
                                         }
                      }
                  ]
}
